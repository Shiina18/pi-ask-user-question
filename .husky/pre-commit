#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only)

echo "Running biome check and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

echo "Running tests..."
npm test
if [ $? -ne 0 ]; then
  echo "❌ Tests failed."
  exit 1
fi

# Re-stage files that may have been modified by formatting
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

echo "✅ All pre-commit checks passed!"
