    "test:watch": "vitest",
    "prepare": "husky || echo husky skipped",
    "pack:check": "npm pack --dry-run"
  },
  "type": "commonjs",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@mariozechner/pi-coding-agent": "^0.71.0",
