    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.71.0",
    "@mariozechner/pi-tui": "^0.71.0",
    "typebox": "^1.1.35"
  }
}
